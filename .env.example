# Canonical local setup template.
#
# Copy this file to .env.local. Every value below is fake or local-only.
# Local Development must use local or disposable infrastructure; never point it
# at a Production database, cache, or provider account.

# Required for local builds
BILLING_PLAN_ENV=dev
CLERK_SECRET_KEY=replace-with-clerk-secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-id
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-id

# Optional local-only application settings and disposable infrastructure
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://127.0.0.1:5432/luster_local
DATABASE_POOL_MAX=2
REDIS_URL=redis://127.0.0.1:6379
APP_ENV=development
LUSTER_ROOT_DOMAIN=example.invalid
TENANT_SUBDOMAINS_ENABLED=false
TENANT_SUBDOMAIN_ALLOWLIST=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
LEGACY_OTP_AUTH_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_PHONE=

# Hosted-only settings (configure in the hosting provider, not in a tracked file)
CRON_SECRET=replace-with-hosted-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-hosted-random-encryption-key
INTEGRATION_ENCRYPTION_KEY_VERSION=1
OAUTH_STATE_SECRET=replace-with-hosted-random-oauth-state-secret
NEXT_PUBLIC_SENTRY_DSN=https://public@example.invalid/1
SENTRY_ORG=example-organization
SENTRY_PROJECT=example-project
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=notifications@example.invalid
RESEND_REPLY_TO_EMAIL=replies@example.invalid

# Optional salon integrations
TWILIO_ACCOUNT_SID=replace-with-twilio-account-id
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=replace-with-twilio-verify-service-id
TWILIO_PHONE_NUMBER=+15550100100
TWILIO_CONNECT_APP_SID=replace-with-twilio-connect-app-id
TWILIO_CONNECT_REDIRECT_URI=https://app.example.invalid/api/integrations/twilio/callback
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.invalid/api/integrations/google/callback
META_APP_ID=000000000000000
META_APP_SECRET=replace-with-meta-app-secret
META_SYSTEM_USER_TOKEN=replace-with-meta-system-user-token
META_FACEBOOK_PAGE_ID=000000000000000
META_INSTAGRAM_ACCOUNT_ID=000000000000000
META_GRAPH_VERSION=v19.0
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=replace-with-cloudinary-public-id
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Customer identity, customer OTP, and customer-session variables are
# intentionally absent because those capabilities are not available yet.
#
# Removing values from the current tree does not remove historical exposure.
# Any still-active historical credential needs provider-side rotation or
# revocation. Rewriting history requires separate owner approval and does not
# replace rotation.
